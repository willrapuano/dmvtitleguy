{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "dmvtitleguy.com" }],
      "destination": "https://dmvtitleguy.io/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.dmvtitleguy.com" }],
      "destination": "https://dmvtitleguy.io/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "src/app/api/agent-tools/contract-analyzer/upload/route.ts": {
      "maxDuration": 60
    }
  }
}
