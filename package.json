{
  "name": "dmvtitleguy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "security:audit": "npm audit --omit=dev --audit-level=high --workspaces=false",
    "verify": "eslint . && tsc --noEmit && prisma generate && next build && npm audit --omit=dev --audit-level=high --workspaces=false",
    "verify:migration": "node scripts/verify-domain-migration.mjs",
    "verify:lead-security": "node scripts/verify-lead-security.mjs",
    "verify:blog-normalizer": "node --experimental-strip-types scripts/verify-blog-normalizer.mjs",
    "verify:blog-rendering": "node scripts/verify-blog-rendering.mjs",
    "verify:blog-publication": "node --experimental-strip-types scripts/verify-blog-publication.mjs",
    "verify:sitemap-completeness": "node --experimental-strip-types scripts/verify-sitemap-completeness.mjs",
    "verify:social-metadata": "node scripts/verify-social-metadata.mjs",
    "verify:dependency-overrides": "node scripts/verify-dependency-overrides.mjs",
    "publish:blogs:daily": "node ../scripts/daily-publish.mjs --limit 1"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@libsql/client": "^0.17.1",
    "@portabletext/react": "^6.0.3",
    "@prisma/adapter-libsql": "^7.5.0",
    "@prisma/client": "^7.9.1",
    "@sanity/client": "^7.25.0",
    "@sanity/image-url": "^2.0.3",
    "@sanity/vision": "5.29.0",
    "@vercel/blob": "^2.3.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "lucide-react": "^0.577.0",
    "next": "16.2.12",
    "next-sanity": "^13.2.3",
    "pdf-parse": "^1.1.1",
    "prisma": "^7.9.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^15.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.9.4",
    "sanity": "5.29.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.12",
    "postcss": "8.5.25",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "brace-expansion": "5.0.9",
    "ejs": "6.0.1",
    "filelist": "2.0.2",
    "jake": "12.10.1",
    "js-yaml": "5.2.2",
    "minimatch": "10.2.6",
    "next": {
      ".": "$next",
      "sharp": "0.35.3"
    },
    "postcss": "8.5.25",
    "typeid-js": {
      ".": "1.2.0",
      "uuid": "11.1.1"
    }
  }
}
